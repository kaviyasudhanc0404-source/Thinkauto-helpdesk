# ThinkAuto Backend — Environment Variables
# Copy to .env for local development. On Render, add each key under Environment.

# ── Server ──────────────────────────────────────────────
# Render sets PORT automatically — do not add it there
PORT=5000
NODE_ENV=production

# ── Database (MongoDB Atlas) ────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thinkauto?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=<long-random-string>
JWT_EXPIRE=7d

# ── URLs ────────────────────────────────────────────────
# Frontend URL(s) allowed by CORS and used in email links. Comma-separate several, no trailing slash.
FRONTEND_URL=https://<your-app>.vercel.app
# ML service base URL (no trailing slash)
ML_SERVICE_URL=https://<your-ml-service>.onrender.com

# ── AI Chatbot ──────────────────────────────────────────
GROQ_API_KEY=<groq-api-key>

# ── Outgoing email ──────────────────────────────────────
# Option A — SMTP (Gmail App Password). Works locally; Render's free tier may block SMTP ports.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=freeuse1606@gmail.com
EMAIL_PASS=<gmail-app-password>

# Option B — Brevo HTTPS API (recommended on Render). When set, it is used instead of SMTP.
# The sender address must be verified in Brevo → Senders.
BREVO_API_KEY=
EMAIL_FROM=freeuse1606@gmail.com

# ── Incoming email → tickets (IMAP) ─────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=freeuse1606@gmail.com
IMAP_PASS=<gmail-app-password>
IMAP_CHECK_INTERVAL=60000

# ── Default admin (used by: npm run seed) ───────────────
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>

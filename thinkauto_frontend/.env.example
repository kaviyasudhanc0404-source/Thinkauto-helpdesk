# ThinkAuto Frontend — Environment Variables
# Local: copy to .env.local. Vercel: add under Project → Settings → Environment Variables.
# Vite embeds this at build time, so redeploy after changing it.

# Backend API base URL (must end with /api, no trailing slash)
# Local:      http://localhost:5000/api
# Production: https://<your-backend>.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Note: the Groq API key is NOT needed here — the chatbot calls the backend, which holds the key.
